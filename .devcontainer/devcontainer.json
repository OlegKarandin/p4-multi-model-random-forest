// GitHub Codespace devcontainer for rerunning the per-task-objective ML
// campaign (spec docs/superpowers/specs/2026-08-23-entries-f1-and-campaign-
// reporting-design.md §8, plan Tasks 26-29). Builds the conda env that
// .devcontainer/environment-linux.yml defines (name: thesis-codespace, see
// that file for the pinned package list and why it exists separately from
// the Windows-pinned repo-root environment.yml). .devcontainer/postCreate.sh
// creates/activates that env and fetches+verifies the two datasets from
// Codespace secrets. .devcontainer/run_campaign.sh is the separate,
// NOT-auto-invoked script that actually launches the several-hour compute
// campaign under nohup (Tasks 28-29 are out of scope for automatic
// execution -- they spend real money and need a human's explicit go-ahead).
//
// NOTE on idle timeout (spec D11 / task-27-brief Step 1: Codespaces maximum,
// 240 minutes): there is NO devcontainer.json field for this. Confirmed
// 2026-08-23 against the containers.dev json-reference (hostRequirements
// covers cpus/memory/storage/gpu only) and GitHub's own "Setting your
// timeout period for GitHub Codespaces" docs, which describe idle timeout
// as a personal-settings / org-policy / `gh codespace create --idle-timeout`
// value only -- never a per-repo dev container setting. postCreate.sh prints
// a reminder at the end of setup; whoever creates the codespace for the
// actual rerun (Task 28/29) must pass `--idle-timeout 240m` to
// `gh codespace create`, or set a 240-minute default under their GitHub
// Settings > Codespaces, themselves.
{
  "name": "thesis-campaign",
  "image": "mcr.microsoft.com/devcontainers/miniconda:3",

  // `gh codespace ssh` (the CLI path used to drive this container headlessly
  // for the Task 28/29 rerun) needs a real sshd inside the container --
  // measured live 2026-08-24: without this, `gh codespace ssh` fails with
  // "failed to start SSH server ... Please check if an SSH server is
  // installed". The miniconda base image doesn't bundle one.
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },

  // Gates which Codespace machine sizes are offered/selected. The plan
  // wanted 16 cores, but `gh codespace create` against this repo measured
  // 2026-08-24: this account's Codespaces entitlement tops out at
  // standardLinux32gb (4 cores) -- a hostRequirements.cpus above the
  // account's ceiling makes `gh codespace create` report ZERO available
  // machines for the repo, not a smaller fallback. Pinned to 4 so a
  // codespace can actually be created; feature_selection.py's
  // `max_workers = min(n_splits, cpu_count - 1)` gets 3 workers against the
  // pilot's 15-split runs (vs. 11 on the original Windows pilot machine) --
  // slower, not broken. Raise this back to 16 only after increasing the
  // account's Codespaces spending limit/machine tier in GitHub billing
  // settings; a stale value here just makes creation fail loudly again.
  "hostRequirements": {
    "cpus": 4
  },

  // Prompts whoever creates the codespace to supply these if not already
  // configured as an account/org/repo Codespace secret, without ever
  // storing a value in this file (D11: a signed URL is a credential).
  // postCreate.sh fails loudly -- non-zero exit, clear stderr message -- if
  // either is unset when a (re-)download is actually needed.
  "secrets": {
    "DATA_URL_APP": {
      "description": "Signed OneDrive URL for resources/apps_flow_features.csv (120,758,907 bytes). Signed URLs expire -- rotate and re-set this secret if postCreate.sh reports a download or checksum failure."
    },
    "DATA_URL_DDOS": {
      "description": "Signed OneDrive URL for resources/Wednesday-workingHours.pcap_ISCX.csv (285,642,925 bytes). Signed URLs expire -- rotate and re-set this secret if postCreate.sh reports a download or checksum failure."
    }
  },

  // Runs once per codespace (after the container exists and the user's
  // secrets are available -- unlike onCreateCommand/updateContentCommand,
  // which run during prebuilds where secrets are deliberately NOT injected).
  // Invoked via `bash` explicitly rather than relying on the script's
  // execute bit, since this repo is authored on Windows where git checkouts
  // routinely drop the +x bit.
  "postCreateCommand": "bash .devcontainer/postCreate.sh",

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
